# Smart Locker System - local configuration
#
# Copy this file to `.env` and fill in the blanks:
#     cp .env.example .env          (macOS / Linux / Git Bash)
#     copy .env.example .env        (Windows cmd)
# or run `make env` to create .env with a random database password.
#
# `.env` is git-ignored. NEVER commit it or paste real passwords into this file.
# Rules for values (so Docker Compose and kubernetes/create-secret.sh agree):
#   - no quotes around values
#   - no comments at the end of a value line
#   - for the password, letters and digits only is safest (e.g. `openssl rand -hex 16`)

# PostgreSQL
POSTGRES_DB=locker_db
POSTGRES_USER=locker_user
# choose a password. Compose cannot start while this is empty.
POSTGRES_PASSWORD=csc3104grp23

# backend
APP_ENV=development


# 127.0.0.1 = only this computer (default, safest).
# 0.0.0.0   = also other devices on the same Wi-Fi, e.g. a phone. Login is required.
#             The database port is never opened.
BIND_ADDRESS=127.0.0.1

# change if something else uses them 
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5433

LOCKER_COUNT=8

# gRPC locker-controller (simulated door hardware)
# Share of unlock calls that fail on purpose (0-1), to watch gRPC retries work.
CONTROLLER_FAILURE_RATE=0
# Simulated time a door takes to open, in milliseconds.
CONTROLLER_ACTUATION_MS=80

# Monitoring (docker compose --profile monitoring up -d)
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
# Virtual luggage demo payments (no real payment provider is used)
LUGGAGE_DEMO_MODE=true
LUGGAGE_AUTH_TTL_HOURS=12

# Administrator account. 02-seed.sql already creates admin / Admin@12345.
# Set a different ADMIN_USERNAME to have the backend create that admin on
# startup with ADMIN_INITIAL_PASSWORD. Existing accounts are never changed,
# so editing the password here later does not reset it.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Admin@12345
