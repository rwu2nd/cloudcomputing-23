# TEMPLATE ONLY - documents the Secrets the cluster expects.
#
# Do NOT put real values in this file and do NOT commit a filled-in copy.
# The recommended way is to let the script create the Secret from your local
# .env file, so nothing sensitive is ever written into a manifest:
#
#     sh kubernetes/create-secret.sh
#
# (The ".example" extension is deliberate: `kubectl apply -f kubernetes/` skips it.)
#
# Equivalent manual commands (POSTGRES_USER must be locker_user, the database
# owner in kubernetes/database/cluster.yaml):
#     kubectl create namespace smart-locker
#     kubectl -n smart-locker create secret generic locker-db-secret \
#       --from-literal=POSTGRES_USER=locker_user \
#       --from-literal=POSTGRES_PASSWORD=<password>
#     kubectl -n smart-locker create secret generic locker-db-app \
#       --type=kubernetes.io/basic-auth \
#       --from-literal=username=locker_user \
#       --from-literal=password=<password>
apiVersion: v1
kind: Secret
metadata:
  name: locker-db-secret
  namespace: smart-locker
type: Opaque
stringData:
  POSTGRES_USER: REPLACE_ME
  POSTGRES_PASSWORD: REPLACE_ME
---
# Read by the CloudNativePG cluster to create the application user.
apiVersion: v1
kind: Secret
metadata:
  name: locker-db-app
  namespace: smart-locker
type: kubernetes.io/basic-auth
stringData:
  username: locker_user
  password: REPLACE_ME
