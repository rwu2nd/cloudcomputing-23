    {
      "id": 20,
      "type": "timeseries",
      "title": "PostgreSQL instances (Kubernetes / CloudNativePG)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (pod, role) (cnpg_collector_up)",
          "legendFormat": "{{pod}} ({{role}})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(smartlocker_database_up)",
          "legendFormat": "backend can query DB"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "custom": {
            "lineWidth": 2,
