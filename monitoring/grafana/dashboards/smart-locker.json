            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "description": "1 = instance up. The role in brackets changes when CloudNativePG promotes a replica after the primary fails.",
      "options": {
        "legend": {
